<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<ApplicationIcon>Charon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationTitle>Charon</ApplicationTitle>
    <AssemblyName>Charon</AssemblyName>
    <RootNamespace>Charon</RootNamespace>
    <Version>1.0.0</Version>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
	<Resource Include="Charon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy ffmpeg.exe alongside Charon.exe -->
    <None Include="..\..\ffmpeg.exe" Condition="Exists('..\..\ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>ffmpeg.exe</Link>
    </None>
  </ItemGroup>
  
  <Target Name="SyncVersionFromIss" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;PrepareForBuild">
    <PropertyGroup>
      <IssFilePath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\Charon.iss'))</IssFilePath>
      <IssContent Condition="Exists('$(IssFilePath)')">$([System.IO.File]::ReadAllText('$(IssFilePath)'))</IssContent>
      <ExtractedIssVersion Condition="'$(IssContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(IssContent)', '#define\s+MyAppVersion\s+&quot;([^&quot;]+)&quot;').Groups[1].Value)</ExtractedIssVersion>
      <Version Condition="'$(ExtractedIssVersion)' != ''">$(ExtractedIssVersion)</Version>
      <InformationalVersion Condition="'$(ExtractedIssVersion)' != ''">$(ExtractedIssVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>