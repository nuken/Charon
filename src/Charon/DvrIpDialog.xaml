<Window x:Class="Charon.DvrIpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Channels DVR Gracenote Sync"
        Width="420" Height="235"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#18181B" Foreground="#F4F4F5">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter Channels DVR Server IP &amp; Port"
                   FontWeight="Bold" FontSize="15" Foreground="#38BDF8" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="Charon will scrape your live channel lineup and query your Channels DVR server to auto-populate Gracenote Station IDs."
                   TextWrapping="Wrap" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,14"/>

        <Grid Grid.Row="2" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="95"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Channels DVR IP Address (Required)" FontSize="12" Foreground="#D4D4D8" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtIp" Height="30" VerticalContentAlignment="Center" Padding="8,0"
                         Background="#09090B" Foreground="#F4F4F5" BorderBrush="#3F3F46" FontSize="13"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text=":" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom" Margin="8,0,8,4"/>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Port" FontSize="12" Foreground="#D4D4D8" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPort" Text="8089" Height="30" VerticalContentAlignment="Center" Padding="8,0"
                         Background="#09090B" Foreground="#F4F4F5" BorderBrush="#3F3F46" FontSize="13"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="85" Height="30" Margin="0,0,10,0"
                    Background="#3F3F46" Foreground="White" BorderThickness="0" Click="BtnCancel_Click" IsCancel="True"/>
            <Button Content="Start Scan" Width="110" Height="30"
                    Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="BtnStart_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>