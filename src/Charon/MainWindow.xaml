<Window x:Class="Charon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Charon — Browser Tuner Bridge"
        Width="980" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#18181B" Foreground="#F4F4F5">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & M3U URL Bar -->
        <Border Grid.Row="0" Background="#27272A" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CHARON STREAMING SERVER" FontWeight="Bold" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        <Border Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAppVersion" Text="v1.0.0" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtM3uUrl" Text="http://0.0.0.0:48590/playlist.m3u" FontFamily="Consolas" FontSize="14" Margin="0,6,0,0" Foreground="#A1A1AA"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCheckUpdate" Content="Check for Updates" Click="BtnCheckUpdate_Click"
                            Padding="12,8" Background="#3F3F46" Foreground="#F4F4F5" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0"
                            ToolTip="Check GitHub (nuken/Charon) for the latest release"/>
                    <Button Content="Copy M3U URL" Click="BtnCopyM3u_Click"
                            Padding="14,8" Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Provider Management, Login & 1-Click Lineup Scan -->
        <Border Grid.Row="1" Background="#27272A" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CmbProviders" Grid.Column="0" VerticalContentAlignment="Center" Height="32" Margin="0,0,10,0" SelectionChanged="CmbProviders_SelectionChanged"/>
                
                <ComboBox x:Name="CmbLoginTarget" Grid.Column="1" Width="140" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" SelectedIndex="0" ToolTip="Select Tuner 1 to automatically sync your login across all 4 tuners, or pick a specific tuner.">
                    <ComboBoxItem Content="Tuner 1 (Sync All)"/>
                    <ComboBoxItem Content="Tuner 2 Only"/>
                    <ComboBoxItem Content="Tuner 3 Only"/>
                    <ComboBoxItem Content="Tuner 4 Only"/>
                </ComboBox>

                <Button x:Name="BtnLoginProvider" Grid.Column="2" Content="1. Login to Provider" Click="BtnLoginProvider_Click"
                        Padding="12,6" Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0"/>
                <Button x:Name="BtnScanLineup" Grid.Column="3" Content="2. Scan &amp; Sync Lineup" Click="BtnScanLineup_Click"
                        Padding="12,6" Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0"
                        ToolTip="Scrapes your live channel lineup from the provider and auto-populates Gracenote Station IDs via your Channels DVR server."/>
                <Button x:Name="BtnReloadProviders" Grid.Column="4" Content="Reload" Click="BtnReloadProviders_Click"
                        Padding="12,6" Background="#3F3F46" Foreground="White" BorderThickness="0"/>
                <TextBlock x:Name="TxtTunerStatus" Grid.Column="5" Text="Active Tuners: 0 / 2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#4ADE80"/>
            </Grid>
        </Border>

        <!-- High-Visibility Busy Progress Banner (Shown During Channel Scrape & Gracenote Matching) -->
        <Border x:Name="BusyBanner" Grid.Row="2" Visibility="Collapsed" Background="#1E3A8A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtBusyStatus" Text="Scanning provider lineup and matching Gracenote IDs... Please wait."
                           FontWeight="Bold" FontSize="13" Foreground="#F4F4F5" Margin="0,0,0,8"/>
                <ProgressBar IsIndeterminate="True" Height="10" Foreground="#38BDF8" Background="#09090B" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Capture, Max Tuners & Window Placement Settings -->
        <Border Grid.Row="3" Background="#27272A" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Resolution:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbResolution" Width="85" Height="28" Margin="0,0,16,0" SelectionChanged="Settings_Changed">
                    <ComboBoxItem Content="720p"/>
                    <ComboBoxItem Content="1080p"/>
                </ComboBox>

                <TextBlock Text="Max Tuners:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbMaxTuners" Width="64" Height="28" Margin="0,0,16,0" SelectionChanged="Settings_Changed">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                </ComboBox>

                <TextBlock Text="Window Mode:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbWindowMode" Width="155" Height="28" Margin="0,0,16,0" SelectionChanged="Settings_Changed">
                    <ComboBoxItem Content="AutoOffScreen"/>
                    <ComboBoxItem Content="CustomCoordinates"/>
                    <ComboBoxItem Content="VisibleDebug"/>
                </ComboBox>

                <TextBlock Text="Custom X:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtCustomX" Width="56" Height="26" VerticalContentAlignment="Center" Margin="0,0,12,0" LostFocus="CustomCoords_LostFocus"/>

                <TextBlock Text="Custom Y:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtCustomY" Width="56" Height="26" VerticalContentAlignment="Center" Margin="0,0,12,0" LostFocus="CustomCoords_LostFocus"/>
            </WrapPanel>
        </Border>

        <!-- Tabbed Workspace: Server Logs & Channel Lineup Editor -->
        <TabControl Grid.Row="4" Background="#09090B" BorderBrush="#27272A" BorderThickness="1">
            <TabItem Header="  Live Server Logs  " FontWeight="SemiBold">
                <TextBox x:Name="TxtLogs" Background="#09090B" Foreground="#D4D4D8" BorderThickness="0" Padding="10"
                         FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </TabItem>

            <TabItem Header="  Channel Lineup Editor (channels.json)  " FontWeight="SemiBold">
                <Grid Background="#18181B" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Row: Primary Actions & Save -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <Button Content="2. Scan &amp; Sync Lineup..." Click="BtnScanLineup_Click"
                                    Padding="12,6" Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0"/>
                            <Button Content="Import JSON..." Click="BtnImportChannels_Click"
                                    Padding="10,6" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,6,0"/>
                            <Button Content="Export Backup..." Click="BtnExportChannels_Click"
                                    Padding="10,6" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,6,0"/>
                            <Button Content="+ Add" Click="BtnAddChannelRow_Click"
                                    Padding="10,6" Background="#27272A" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,6,0"/>
                            <Button Content="- Delete" Click="BtnDeleteChannelRow_Click"
                                    Padding="10,6" Background="#450A0A" Foreground="#FCA5A5" BorderBrush="#7F1D1D" BorderThickness="1" Margin="0,0,8,0"/>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkRawJsonMode" Content="Raw JSON" Foreground="#A1A1AA" VerticalAlignment="Center"
                                      Margin="0,0,12,0" Checked="ChkRawJsonMode_Changed" Unchecked="ChkRawJsonMode_Changed"/>
                            <Button Content="Save Lineup" Click="BtnSaveChannels_Click"
                                    Padding="16,6" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Second Row: Search Filter, Bulk Hide/Show & Channel Counter -->
                    <Border Grid.Row="1" Background="#27272A" CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Filter:" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtChannelFilter" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                                     Background="#09090B" Foreground="#F4F4F5" BorderBrush="#3F3F46" BorderThickness="1" Padding="6,0"
                                     TextChanged="TxtChannelFilter_TextChanged"
                                     ToolTip="Search by Channel Name, Ch #, ID, or Gracenote Station ID"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0">
                                <Button Content="Hide Selected" Click="BtnHideSelected_Click"
                                        Padding="10,4" Background="#3F3F46" Foreground="#F4F4F5" BorderThickness="0" Margin="0,0,6,0"
                                        ToolTip="Hides all highlighted rows from the M3U playlist"/>
                                <Button Content="Show Selected" Click="BtnShowSelected_Click"
                                        Padding="10,4" Background="#3F3F46" Foreground="#F4F4F5" BorderThickness="0" Margin="0,0,6,0"
                                        ToolTip="Enables all highlighted rows in the M3U playlist"/>
                                <Button Content="Show All" Click="BtnShowAll_Click"
                                        Padding="10,4" Background="#3F3F46" Foreground="#38BDF8" BorderThickness="0"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtLineupStats" Grid.Column="3" Text="0 active in M3U (0 hidden)"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="#A1A1AA" FontWeight="SemiBold" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- Modern Dark-Mode DataGrid View -->
                    <DataGrid x:Name="GridChannels" Grid.Row="2" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="True"
                              Background="#09090B" Foreground="#F4F4F5"
                              RowBackground="#121215" AlternatingRowBackground="#18181C"
                              BorderBrush="#27272A" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A"
                              HeadersVisibility="Column" RowHeight="34" FontSize="13"
                              SelectionMode="Extended" SelectionUnit="FullRow">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#3F3F46"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>

                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                        <Setter Property="Opacity" Value="0.42"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#0369A1"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- M3U Active/Hidden Toggle Column -->
                            <DataGridTemplateColumn Header="Hide" Width="58">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsHidden, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Click="ChkRowHidden_Click"
                                                  ToolTip="Check to hide this channel from playlist.m3u"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Ch #" Binding="{Binding ChannelNumber, UpdateSourceTrigger=PropertyChanged}" Width="68" FontFamily="Consolas" Foreground="#38BDF8"/>
                            <DataGridTextColumn Header="Channel Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="190" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Gracenote ID" Binding="{Binding StationId, UpdateSourceTrigger=PropertyChanged}" Width="115" FontFamily="Consolas" Foreground="#4ADE80"/>
                            <DataGridTextColumn Header="ID (Slug)" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="145" FontFamily="Consolas" Foreground="#A1A1AA"/>
                            <DataGridTextColumn Header="Watch URL" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Width="*" FontFamily="Consolas" Foreground="#A1A1AA"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Raw JSON Text Editor View -->
                    <TextBox x:Name="TxtRawChannelsJson" Grid.Row="2" Visibility="Collapsed"
                             Background="#09090B" Foreground="#38BDF8" BorderBrush="#3F3F46" BorderThickness="1" Padding="10"
                             FontFamily="Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>